# Copy to .env.local for development, or set in the Vercel dashboard for production.
#
# ⚠️ ANYTHING PREFIXED `VITE_` IS COMPILED INTO THE JAVASCRIPT BUNDLE AND IS
#    PUBLICLY READABLE. Never put an API key here. The Gemini key lives only in
#    the BACKEND environment — see backend/.env.example.

# Where the FastAPI backend lives.
#
# Leave EMPTY for local development: requests stay relative and Vite's dev proxy
# forwards them to 127.0.0.1:8000.
#
# Set to the deployed backend origin in production, with no trailing slash:
#   VITE_API_BASE_URL=https://gramini-backend.onrender.com
VITE_API_BASE_URL=
