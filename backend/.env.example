# Copy this file to .env and fill in your own key.
#
#     copy .env.example .env        (Windows)
#     cp   .env.example .env        (macOS / Linux)
#
# This file is a TEMPLATE and is meant to be shared and submitted.
# Never put a real key in here - put it in .env, which stays on your machine.

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Change if you want a different Gemini model.
#
# Free-tier quota is counted PER MODEL PER DAY (20 requests), so switching to an
# unused model is the quickest way to recover from a 429.
#
# Use an EXPLICIT name, not a "-latest" alias: an alias resolves to some other
# model, and the quota is charged against THAT one. Asking for
# gemini-flash-latest produced a 429 naming gemini-3.6-flash, which made the
# quota impossible to reason about.
#
# Known good: gemini-3.5-flash, gemini-3.1-flash-lite, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash

# Optional. Used automatically when the first key hits its quota.
# Make this one on a DIFFERENT Google account, or it shares the same limit.
GEMINI_API_KEY_BACKUP=

# Optional. Translation runs on its own model so bulk translating languages
# cannot eat the quota the live demo needs. Keep this DIFFERENT from
# GEMINI_MODEL - that separation is the whole point.
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite

# Optional. Attempts per key before moving to the next one. Transient failures
# (network, DNS, timeout, 503) are retried with exponential backoff; quota and
# auth failures are not, because retrying those cannot help.
GEMINI_MAX_ATTEMPTS=3

# Optional. Set to DEBUG to see full tracebacks for every failed API call.
GRAMINI_LOG_LEVEL=INFO

# Production only. The deployed frontend origin, for CORS.
# Comma-separated if you need more than one. Local dev origins are always
# allowed, so this can stay empty on a laptop.
FRONTEND_URL=http://localhost:5173
